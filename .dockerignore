node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local build outputs (so they don't accidentally get copied)
dist
build

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore version control and IDE settings
.git
.gitignore
.vscode
.idea
.DS_Store
